{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbe.dev/interior/building.schema.json",
  "title": "Interior building layout references",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "architecture": { "type": "string", "description": "Exterior architecture selecting the paired interior recipe." },
    "version": {
      "const": 1
    },
    "generatorVersion": {
      "type": "string",
      "minLength": 1
    },
    "buildingId": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "string",
      "minLength": 1
    },
    "props": {
      "type": "string",
      "minLength": 1
    },
    "materialTheme": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "minLength": 1
    },
    "corePlacement": {
      "type": "object",
      "additionalProperties": false,
      "description": "the stair this building was furnished around; coreFeasibility publishes the same shape",
      "required": ["stairA"],
      "properties": {
        "stairA": {
          "type": "object",
          "additionalProperties": false,
          "required": ["center", "axis", "width", "depth"],
          "properties": {
            "center": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
            "axis": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "depth": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "reservationCrossing": {
      "type": "object",
      "additionalProperties": true,
      "description": "present when the only core the plate holds crosses an exterior opening reservation",
      "required": ["floor", "opening", "coreSolid", "requiredDepth", "availableDepth"],
      "properties": {
        "floor": { "type": "integer" },
        "opening": { "type": "string", "minLength": 1 },
        "coreSolid": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "requiredDepth": { "type": "number" },
        "availableDepth": { "type": "number" }
      }
    },
    "layouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ground": {
          "type": "string",
          "minLength": 1
        },
        "middle": {
          "type": "string",
          "minLength": 1
        },
        "crown": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^floor-[0-9]+$": { "type": "string", "minLength": 1 }
      },
      "description": "Repeated floors share a layout; distinct intermediate plates use floor-<index>. Single-floor buildings publish only ground.",
      "required": [
        "ground"
      ]
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer"
          },
          "layout": {
            "type": "string",
            "pattern": "^(ground|middle|crown|floor-[0-9]+)$"
          },
          "elevation": {
            "type": "number"
          },
          "openings": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "treatments": {
            "type": "array",
            "description": "this floor's own window returns, built from its own openings",
            "items": { "$ref": "floor-placement.schema.json#/properties/placements/items" }
          },
          "program": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "changes"],
            "description": "Present when service rooms are reduced. Each floor records the changes from its reusable layout, in reduction order.",
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "changes": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["kind", "requested", "fitted"],
                  "properties": {
                    "kind": { "$ref": "floor.schema.json#/properties/rooms/items/properties/kind" },
                    "requested": { "$ref": "#/$defs/roomSize" },
                    "fitted": {
                      "description": "Room width and depth in metres, or null when omitted.",
                      "anyOf": [{ "$ref": "#/$defs/roomSize" }, { "type": "null" }]
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "index",
          "layout",
          "elevation",
          "openings"
        ]
      },
      "minItems": 1
    },
    "connectors": {
      "$ref": "npc.schema.json#/properties/nav/properties/connectors"
    }
  },
  "$defs": {
    "roomSize": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    }
  },
  "required": [
    "version",
    "generatorVersion",
    "buildingId",
    "modules",
    "props",
    "materialTheme",
    "tier",
    "layouts",
    "corePlacement",
    "floors",
    "connectors"
  ]
}
