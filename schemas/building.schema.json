{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbe.dev/interior/building.schema.json",
  "title": "Interior building layout references",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "generatorVersion": {
      "type": "string",
      "minLength": 1
    },
    "buildingId": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "string",
      "minLength": 1
    },
    "props": {
      "type": "string",
      "minLength": 1
    },
    "materialTheme": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "minLength": 1
    },
    "layouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ground": {
          "type": "string",
          "minLength": 1
        },
        "middle": {
          "type": "string",
          "minLength": 1
        },
        "crown": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ground",
        "middle",
        "crown"
      ]
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer"
          },
          "layout": {
            "enum": [
              "ground",
              "middle",
              "crown"
            ]
          },
          "elevation": {
            "type": "number"
          },
          "openings": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "program": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "changes"],
            "description": "Present when service rooms are reduced. Each floor records the changes from its reusable layout, in reduction order.",
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "changes": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["kind", "requested", "fitted"],
                  "properties": {
                    "kind": { "$ref": "floor.schema.json#/properties/rooms/items/properties/kind" },
                    "requested": { "$ref": "#/$defs/roomSize" },
                    "fitted": {
                      "description": "Room width and depth in metres, or null when omitted.",
                      "anyOf": [{ "$ref": "#/$defs/roomSize" }, { "type": "null" }]
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "index",
          "layout",
          "elevation",
          "openings"
        ]
      },
      "minItems": 3
    },
    "connectors": {
      "$ref": "npc.schema.json#/properties/nav/properties/connectors"
    }
  },
  "$defs": {
    "roomSize": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    }
  },
  "required": [
    "version",
    "generatorVersion",
    "buildingId",
    "modules",
    "props",
    "materialTheme",
    "tier",
    "layouts",
    "floors",
    "connectors"
  ]
}
