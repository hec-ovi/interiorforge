{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urbe/interior/blueprint-consumed",
  "title": "BlueprintConsumed",
  "description": "Consumer view of the canonical Exterior blueprint. Interior reads the floor core and bounds; additive Exterior sections pass through. Units meters, +Y up, XZ floor plane, CCW outlines. Negative floor indexes are basements.",
  "type": "object",
  "required": ["buildingId", "floors"],
  "additionalProperties": true,
  "properties": {
    "buildingId": { "type": "string" },
    "bounds": {
      "type": "object",
      "required": ["footprint", "height"],
      "additionalProperties": true,
      "properties": {
        "footprint": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point2" } },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "facade": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "style": { "type": "string", "description": "exterior facade style (curtain-wall, glass, panel, megablock); picks the shell wall depth the interior keeps clear of when wallDepth is absent" },
        "wallDepth": { "type": "number", "minimum": 0, "description": "measured inward reach of the shell wall in meters (reveals, frames, glazing, closed leaves); read ahead of the per-style table" },
        "grids": {
          "type": "array",
          "description": "exact facade grids; partitionAnchors are the only full-thickness endpoints an interior partition may use",
          "items": {
            "type": "object",
            "required": ["floor", "edge", "partitionAnchors"],
            "additionalProperties": true,
            "properties": {
              "floor": { "type": "integer" },
              "edge": { "type": "integer", "minimum": 0 },
              "partitionAnchors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["offset", "width"],
                  "additionalProperties": false,
                  "properties": {
                    "offset": { "type": "number", "minimum": 0, "description": "centre along the outline edge" },
                    "width": { "type": "number", "exclusiveMinimum": 0, "description": "complete opening-free structural width" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "roof": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "elevation": { "type": "number", "description": "roof walking surface and enclosure-door threshold" },
        "outline": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point2" } },
        "parapetHeight": { "type": "number", "minimum": 0 },
        "bulkhead": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["center", "axis", "width", "depth", "housingHeight", "doorNormal", "doorWidth", "doorHeight"],
              "additionalProperties": true,
              "properties": {
                "center": { "$ref": "#/$defs/point2" },
                "axis": { "$ref": "#/$defs/point2" },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "depth": { "type": "number", "exclusiveMinimum": 0 },
                "housingHeight": { "type": "number", "exclusiveMinimum": 0 },
                "doorNormal": { "$ref": "#/$defs/point2" },
                "doorWidth": { "type": "number", "exclusiveMinimum": 0 },
                "doorHeight": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["center", "size", "rotationDeg"],
            "additionalProperties": true,
            "properties": {
              "center": { "$ref": "#/$defs/point2" },
              "size": {
                "type": "array",
                "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
                "minItems": 3,
                "maxItems": 3
              },
              "rotationDeg": { "type": "number" }
            }
          }
        }
      }
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "kind", "elevation", "height", "outline", "openings"],
        "additionalProperties": true,
        "properties": {
          "index": { "type": "integer", "description": "0 = ground floor, contiguous; negative = basement" },
          "kind": { "type": "string", "description": "exterior slot label slug (lobby, residential, office, basement...); assignments win over it" },
          "elevation": { "type": "number", "description": "Y of this floor's walking surface" },
          "height": { "type": "number", "minimum": 2.2, "maximum": 12, "description": "floor-to-floor distance" },
          "outline": {
            "type": "array",
            "minItems": 3,
            "items": { "$ref": "#/$defs/point2" },
            "description": "CCW simple polygon of the floor plate, [x, z]"
          },
          "openings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind", "edge", "offset", "width", "height", "sill"],
              "additionalProperties": true,
              "properties": {
                "id": { "type": "string" },
                "kind": { "enum": ["door", "window", "balconyDoor", "openFront", "aperture"] },
                "edge": { "type": "integer", "minimum": 0, "description": "outline edge index (vertex i to i+1)" },
                "offset": { "type": "number", "minimum": 0, "description": "meters along the edge to the opening's start" },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "sill": { "type": "number", "minimum": 0, "description": "bottom of opening above floor surface" },
                "portal": {
                  "type": "object",
                  "required": ["frameWidth", "frameDepth", "recessDepth", "clearWidth", "clearHeight", "clearDepth"],
                  "additionalProperties": false,
                  "description": "openFront only: fixed surround and exact traversable dimensions of the permanently open street connection",
                  "properties": {
                    "frameWidth": { "type": "number", "exclusiveMinimum": 0 },
                    "frameDepth": { "type": "number", "exclusiveMinimum": 0 },
                    "recessDepth": { "type": "number", "exclusiveMinimum": 0 },
                    "clearWidth": { "type": "number", "exclusiveMinimum": 0 },
                    "clearHeight": { "type": "number", "exclusiveMinimum": 0 },
                    "clearDepth": { "type": "number", "exclusiveMinimum": 0 }
                  }
                },
                "accessRole": {
                  "const": "main",
                  "description": "openFront only: the primary navigation connection, with no moving leaf"
                },
                "door": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "motion": {
                      "type": "object",
                      "required": ["clearDepth"],
                      "additionalProperties": true,
                      "properties": {
                        "clearDepth": { "type": "number", "minimum": 0, "description": "inward space reserved for the moving leaf" }
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "kind": { "const": "openFront" } }, "required": ["kind"] },
                  "then": { "required": ["portal", "accessRole"] }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "point2": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
