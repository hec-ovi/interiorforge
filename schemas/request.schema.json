{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urbe/interior/request",
  "title": "InteriorRequest",
  "description": "Full input of the interior generator. Same request always yields identical output.",
  "type": "object",
  "required": [
    "seed",
    "building",
    "blueprint",
    "materialTheme"
  ],
  "additionalProperties": false,
  "properties": {
    "seed": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "description": "string seeds (e.g. the exterior seed) are hashed internally"
    },
    "building": {
      "type": "object",
      "required": [
        "id",
        "type",
        "tier"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "residential",
            "hotel",
            "offices",
            "corpo",
            "hospital",
            "clinic",
            "police",
            "military",
            "factory",
            "commerce",
            "mall",
            "restaurant",
            "coffee_shop"
          ],
          "description": "atlas parcel vocabulary, verbatim"
        },
        "interiorStyle": {
          "enum": ["h10", "japantown", "sandra-dorsett", "apartment-1702"],
          "description": "Reference identity independent of exterior and seed: standard residential/hotel, or rich residential paired-storey Apartment 1702."
        },
        "kind": {
          "enum": ["A", "B", "C", "R"],
          "description": "Reference building kind: A high-tech luxury tower, B rich glass building, C poor capsule building, R rich office. Derived from type, tier and architecture when omitted."
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["e1-apartment", "e2-floor", "e5-lobby2", "e6-apartment2", "b1-floor", "b2-suite", "b3-apartment", "b4-loft", "c1-capsule", "c2-corridors", "c3-poor", "c4-bathroom", "c5-machine", "c6-studio", "c7-room", "r1-office"]
          },
          "description": "Restricts the space templates the building may fit to these keys, which must belong to its kind."
        },
        "tier": {
          "enum": [
            "poor",
            "mid",
            "rich",
            "high_rich"
          ]
        }
      }
    },
    "shellGlb": {
      "type": "string",
      "description": "path to the exterior shell GLB"
    },
    "blueprint": {
      "$ref": "blueprint-consumed"
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "description": "one entry per floor index (negative = basement); a double-height floor (loft, corpo hall) owns two blueprint floors via spans: 2. Optional: when omitted, assignments derive deterministically from the blueprint floor kind slugs and the building type.",
      "items": {
        "type": "object",
        "required": [
          "floor",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "floor": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "lobby",
              "office",
              "corpo_office",
              "restaurant",
              "coffee_shop",
              "gym",
              "retail",
              "mall_floor",
              "residence_studio",
              "apartment",
              "hotel_rooms",
              "mechanical",
              "parking",
              "terrace"
            ]
          },
          "spans": {
            "enum": [
              1,
              2
            ],
            "default": 1
          }
        }
      }
    },
    "materialTheme": {
      "type": "string",
      "description": "theme id resolved by the materials box; interior references materials as theme/kind/tier keys"
    }
  }
}
