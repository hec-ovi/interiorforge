{
  "name": "urbe-interior",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "description": "Deterministic building interior generator: fills an exterior GLB shell with per-floor rooms, stairs, elevators, furniture placeholders and NPC routine data.",
