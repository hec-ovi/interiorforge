{
  "name": "urbe-interior",
  "version": "0.30.0",
  "private": true,
  "type": "module",
  "description": "Deterministic building interior generator with rooms, stairs, elevators, shaped furniture and NPC routine data.",
  "scripts": {
    "assets:import": "tsx src/assets/scripts/import-assets.ts",
    "build:feasibility": "tsc -p tsconfig.feasibility.json",
    "generate": "tsx src/cli.ts",
    "preview": "vite --config src/ui/vite.config.ts",
    "test": "npm run build:feasibility && vitest run tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.0",
    "three": "^0.185.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
